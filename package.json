{
  "name": "codex-usage-profile",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:runtime": "node src/profile-runtime/dev-server.js",
    "start": "node src/profile-runtime/production-server.js",
    "build": "vite build",
    "build:cloud-run": "vite build --configLoader runner",
    "build:marketing": "npm run build:sites",
    "build:sites": "vite build --config vite.sites.config.js --configLoader runner",
    "build:sites-fullstack": "vite build --config vite.sites-fullstack.config.js && node scripts/finalize-sites-fullstack-artifact.mjs",
    "build:production": "npm run build:sites-fullstack",
    "cleanup:card-media": "node scripts/cleanup-orphan-card-media.mjs",
    "migrate:postgres": "node src/profile-backend/postgres/migrate.js",
    "migrate:seed": "node scripts/migrate-file-store-to-postgres.mjs",
    "package:sites-target": "node scripts/materialize-sites-target.mjs",
    "preview:sites": "vite preview --config vite.sites.config.js --configLoader runner --host 127.0.0.1 --port 4174",
    "preview:sites-fullstack": "vite preview --config vite.sites-fullstack.config.js --host 127.0.0.1 --port 4175",
    "scan:public-release": "node scripts/scan-public-release-surface.mjs",
    "smoke:cloud-run": "node scripts/smoke-cloud-run-container.mjs codex-usage-profile:task37",
    "smoke:hosting-matrix": "node scripts/smoke-hosting-matrix.mjs",
    "smoke:npm-package:local": "node scripts/smoke-npm-package-local.mjs",
    "smoke:sites-fullstack:local": "node scripts/smoke-sites-fullstack-local.mjs",
    "smoke:sites-production:local": "node scripts/smoke-sites-production-local.mjs",
    "sites:profile-maintenance": "node scripts/sites-profile-maintenance.mjs",
    "test": "node --test",
    "test:e2e": "playwright test",
    "verify:npm-release": "node scripts/verify-npm-release.mjs",
    "verify:sites-fullstack": "node scripts/verify-sites-fullstack-artifact.mjs",
    "verify:sites-production": "node scripts/verify-sites-production-artifact.mjs --expected-project-id appgprj_6a83ecc3c4c08191bda7f14d7c26c974"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1092.0",
    "@fontsource/noto-sans-kr": "^5.2.9",
    "@napi-rs/canvas": "^1.0.2",
    "@resvg/resvg-wasm": "^2.6.2",
    "border-beam": "^1.3.0",
    "gifenc": "1.0.3",
    "hover-tilt": "^1.0.0",
    "lucide-react": "^1.28.0",
    "pg": "^8.22.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@playwright/test": "^1.60.0",
    "@vitejs/plugin-react": "^6.0.2",
    "vite": "^8.0.16",
    "wrangler": "4.92.0"
  }
}
