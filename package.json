{
  "name": "codex-usage-profile",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:runtime": "node src/profile-runtime/dev-server.js",
    "build": "vite build",
