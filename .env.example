GITHUB_CLIENT_ID=<github-oauth-client-id>
GITHUB_CLIENT_SECRET=<github-oauth-client-secret>
PUBLIC_BASE_URL=http://127.0.0.1:5173
PROFILE_STORE_FILE=.data/profile-store.json
PROFILE_MEDIA_MODE=memory
SESSION_SECURE_COOKIES=false

# Required only when PROFILE_MEDIA_MODE=external. Keep every R2_* value
# server-side; production accepts external media only.
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_BUCKET=<r2-bucket-name>
R2_ACCESS_KEY_ID=<r2-access-key-id>
R2_SECRET_ACCESS_KEY=<r2-secret-access-key>
R2_REGION=auto

# Optional gated S3-compatible integration fixture (for example MinIO).
TEST_S3_ENDPOINT=http://127.0.0.1:9000
TEST_S3_BUCKET=<test-bucket-name>
TEST_S3_ACCESS_KEY_ID=<test-access-key-id>
TEST_S3_SECRET_ACCESS_KEY=<test-secret-access-key>
TEST_S3_REGION=us-east-1
TEST_S3_FORCE_PATH_STYLE=true
